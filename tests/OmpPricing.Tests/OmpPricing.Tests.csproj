<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OmpPricing.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OmpPricing.App/OmpPricing.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../samples/LT2026100009.xlsx" Link="samples/LT2026100009.xlsx" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/OmpPricing.App/appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../rules/**/*" LinkBase="rules" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Providers/DigiKey/fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
